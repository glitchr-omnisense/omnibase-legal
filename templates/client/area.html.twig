{# One field of practice (Base\Legal\Practice\Controller\Client\PracticeController::area). #}
{% extends office_layout() %}
{% set profession = legal_profession() %}

{% block title %}{{ area.name }}{% endblock %}
{% block description %}{{ area.summary }}{% endblock %}

{% block content %}
<article class="of-page lg-area">
    <p class="of-back"><a href="{{ path('legal_areas') }}">← {{ 'areas.title'|trans({}, 'legal') }}</a></p>
    <header class="of-page-head">
        <h1>{{ area.name }}</h1>
        {% if area.summary %}<p class="of-lead">{{ area.summary }}</p>{% endif %}
    </header>
    <div class="of-columns">
        <div class="of-prose">
            {% for paragraph in area.paragraphs %}<p>{{ paragraph|nl2br }}</p>{% endfor %}
            <p class="of-actions"><a class="of-button" href="{{ path('legal_request') }}">{{ 'areas.ask'|trans({}, 'legal') }}</a></p>
        </div>
        <aside>
            {% if area.items %}
            <h2>{{ (profession ~ '.areas.items')|trans({}, 'legal') }}</h2>
            <ul class="lg-items">{% for item in area.items %}<li>{{ item }}</li>{% endfor %}</ul>
            {% endif %}
            {% if area.members|length %}
            <h2>{{ 'areas.team'|trans({}, 'legal') }}</h2>
            <ul class="of-list">{% for member in area.members %}{% if member.visible and member.active %}<li><a href="{{ path('office_member', {slug: member.slug}) }}">{{ member.displayName }}</a>{% if member.title %} <span class="of-meta">— {{ member.title }}</span>{% endif %}</li>{% endif %}{% endfor %}</ul>
            {% endif %}
            <h2>{{ 'areas.cost'|trans({}, 'legal') }}</h2>
            <p>{{ (profession ~ '.areas.cost_text')|trans({}, 'legal') }} <a href="{{ path(legal_fees_route()) }}">{{ (profession ~ '.areas.cost_link')|trans({}, 'legal') }}</a></p>
        </aside>
    </div>
    {% if areas|length > 1 %}
    <nav class="lg-others" aria-label="{{ 'areas.others'|trans({}, 'legal') }}">
        <h2>{{ 'areas.others'|trans({}, 'legal') }}</h2>
        <ul>{% for other in areas %}{% if other.id != area.id %}<li><a href="{{ path('legal_area', {slug: other.slug}) }}">{{ other.name }}</a></li>{% endif %}{% endfor %}</ul>
    </nav>
    {% endif %}
</article>
{% endblock %}
